{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "similarweb-alternative: credential-free recipe input subset",
  "type": "object",
  "properties": {
    "domains": {
      "type": "array",
      "minItems": 1,
      "maxItems": 25,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "free_tier",
        "bulk_paid"
      ]
    },
    "countryName": {
      "type": "string"
    },
    "languageCode": {
      "type": "string"
    },
    "includeCompetitors": {
      "type": "boolean"
    },
    "includeKeywords": {
      "type": "boolean"
    },
    "includeTechnologies": {
      "type": "boolean"
    },
    "includeSimilarweb": {
      "type": "boolean"
    },
    "keywordLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "competitorLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "onPartialFailure": {
      "type": "string",
      "enum": [
        "return_partial",
        "fail_if_any_batch_fails"
      ]
    }
  },
  "required": [
    "domains"
  ],
  "additionalProperties": false
}
