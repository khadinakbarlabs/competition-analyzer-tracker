{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "website-seo-spider: credential-free recipe input subset",
  "type": "object",
  "properties": {
    "startUrls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    "crawlScope": {
      "type": "string",
      "enum": [
        "same-hostname",
        "same-domain",
        "page-only"
      ]
    },
    "maxPages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2000
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "seedFromSitemap": {
      "type": "boolean"
    },
    "respectRobotsTxt": {
      "type": "boolean"
    },
    "ignoreUrlParameters": {
      "type": "boolean"
    },
    "maxConcurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "fetchMode": {
      "type": "string",
      "enum": [
        "direct",
        "residential"
      ]
    }
  },
  "required": [
    "startUrls"
  ],
  "additionalProperties": false
}
