{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "firecrawl-alternative: credential-free recipe input subset",
  "type": "object",
  "properties": {
    "startUrls": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "maxLength": 2048
      }
    },
    "crawlScope": {
      "type": "string",
      "enum": [
        "same-hostname",
        "same-domain",
        "page-only"
      ]
    },
    "maxPages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    },
    "maxDepth": {
      "type": "integer",
      "minimum": 0,
      "maximum": 8
    },
    "includeHtml": {
      "type": "boolean"
    },
    "removeSelectors": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 200
      },
      "maxItems": 20
    },
    "respectRobotsTxt": {
      "type": "boolean"
    },
    "maxConcurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  },
  "required": [
    "startUrls"
  ],
  "additionalProperties": false
}
