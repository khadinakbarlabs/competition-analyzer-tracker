{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "scrape-google-serp: credential-free recipe input subset",
  "type": "object",
  "properties": {
    "queries": {
      "type": "array"
    },
    "maxResultsPages": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "resultsPerPage": {
      "type": "integer",
      "minimum": 10,
      "maximum": 100
    },
    "countryCode": {
      "type": "string",
      "maxLength": 5
    },
    "languageCode": {
      "type": "string",
      "maxLength": 10
    },
    "includeAds": {
      "type": "boolean"
    },
    "includeFeaturedSnippet": {
      "type": "boolean"
    },
    "includePeopleAlsoAsk": {
      "type": "boolean"
    },
    "includeRelatedSearches": {
      "type": "boolean"
    },
    "includeKnowledgeGraph": {
      "type": "boolean"
    },
    "maxConcurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "required": [],
  "additionalProperties": false
}
