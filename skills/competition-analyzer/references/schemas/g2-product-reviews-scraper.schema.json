{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "g2-product-reviews-scraper: credential-free recipe input subset",
  "type": "object",
  "properties": {
    "startUrls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      }
    },
    "maxReviewsPerProduct": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5000
    },
    "maxProductsPerSearch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "includeReviews": {
      "type": "boolean"
    },
    "sortReviewsBy": {
      "type": "string",
      "enum": [
        "newest",
        "helpful"
      ]
    },
    "debug": {
      "type": "boolean"
    }
  },
  "required": [],
  "additionalProperties": false
}
