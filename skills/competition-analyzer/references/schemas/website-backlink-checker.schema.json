{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "website-backlink-checker: credential-free recipe input subset",
  "type": "object",
  "properties": {
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "mode": {
      "type": "string",
      "enum": [
        "backlinks",
        "referring_domains",
        "anchors",
        "summary"
      ]
    },
    "maxResults": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    },
    "dofollowOnly": {
      "type": "boolean"
    },
    "excludeLost": {
      "type": "boolean"
    },
    "includeSubdomains": {
      "type": "boolean"
    },
    "excludeInternalBacklinks": {
      "type": "boolean"
    }
  },
  "required": [
    "targets"
  ],
  "additionalProperties": false
}
