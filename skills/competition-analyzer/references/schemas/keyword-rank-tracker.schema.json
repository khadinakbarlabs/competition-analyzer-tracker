{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "keyword-rank-tracker: credential-free recipe input subset",
  "type": "object",
  "properties": {
    "targetDomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "keywords": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 700
      }
    },
    "locationCode": {
      "type": "integer",
      "minimum": 1
    },
    "languageCode": {
      "type": "string",
      "pattern": "^[a-zA-Z]{2,5}$"
    },
    "device": {
      "type": "string",
      "enum": [
        "desktop",
        "mobile"
      ]
    },
    "os": {
      "type": "string",
      "enum": [
        "windows",
        "macos",
        "android",
        "ios"
      ]
    },
    "depth": {
      "type": "integer",
      "minimum": 10,
      "maximum": 20
    },
    "maxKeywords": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100
    }
  },
  "required": [
    "targetDomain",
    "keywords"
  ],
  "additionalProperties": false
}
